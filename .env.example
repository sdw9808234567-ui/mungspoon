# ─────────────────────────────────────────────
# 멍스푼 환경변수 예시 (Vercel > Settings > Environment Variables 에 입력)
# 이 파일은 "예시"입니다. 실제 키는 절대 이 파일에 적지 마세요.
# ─────────────────────────────────────────────

# AI 사용 방식: demo(기본, 무료·AI 없이 규칙 기반 레시피) 또는 anthropic(유료 AI 연결)
AI_PROVIDER=demo

# AI_PROVIDER=anthropic 일 때만 필요 (유료). 서버에서만 읽히고 화면(브라우저)에는 노출되지 않습니다.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# 네이버 블로그 '바른 멍생활' 주소 (비워 두면 코드의 기본값 https://blog.naver.com/ssm4579 사용)
NEXT_PUBLIC_BLOG_URL=
# (선택) 블로그 안의 '수제간식 후기' / '레시피' 카테고리 주소
NEXT_PUBLIC_BLOG_REVIEW_URL=
NEXT_PUBLIC_BLOG_RECIPE_URL=

# (플레이스토어 앱 연결용 · 선택) PWABuilder로 앱을 만든 뒤에 입력하세요. 자세한 방법: store-assets/README.md
# 앱 패키지 이름 (예: com.barunmeong.mungspoon)
TWA_PACKAGE_NAME=
# 서명 지문 SHA-256. 여러 개면 쉼표(,)로 구분 (PWABuilder 지문 + 플레이 콘솔 '앱 서명 키' 지문)
TWA_SHA256=
